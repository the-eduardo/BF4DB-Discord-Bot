# Copy to .env (git-ignored).

# Discord bot token: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# BF4DB Patreon API key: https://bf4db.com/patreon
BF4DB_API=

# Optional: register slash commands in a single guild (instant) instead of
# globally (up to an hour to propagate).
# DISCORD_GUILD_ID=

# Optional: debug | info | warn | error
# LOG_LEVEL=info

# Optional: how many name-search hits to look up (default 15).
# BF4DB_NAME_LIMIT=15

# Optional: override the API and website roots (proxy, mock).
# BF4DB_BASE_URL=https://bf4db.com/api
# BF4DB_WEB_URL=https://bf4db.com
